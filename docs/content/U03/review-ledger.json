    {
      "id": "audio:/assets/audio/u03/listening-01.wav",
      "kind": "audio",
      "src": "/assets/audio/u03/listening-01.wav",
      "script": "いまは、しちじです。アキは、しちじにたべます。はちじにべんきょうします。",
      "sha256": "72caeca6e61b3a8f3c1a6500b64e6152889c88ff6913deff9c2c95ff2a6136bf",
      "status": "NOT_RUN",
      "reviewer": null,
