    },
    {
      "id": "audio:/assets/audio/u03/listening-04.wav",
      "kind": "audio",
      "src": "/assets/audio/u03/listening-04.wav",
      "script": "アキは、あさろくじにおきます。しちじにたべます。はちじによみます。よるくじにねます。",
      "sha256": "b2df4e95268d500c96ee71a088d47cd413d092f55215b504360fd57a327e9d02",
      "status": "NOT_RUN",
      "reviewer": null,
      "reviewedAt": null
    },
    {
