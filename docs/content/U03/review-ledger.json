      "kind": "audio",
      "src": "/assets/audio/u03/listening-05.wav",
      "script": "なんじに、おきますか。",
      "sha256": "3fcfd2e3fed91fe62c119f8c5fbc52585f1272a9502179a510ac3f38682c3a28",
      "status": "NOT_RUN",
      "reviewer": null,
