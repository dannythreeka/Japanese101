    },
    {
      "id": "audio:/assets/audio/u03/listening-02.wav",
      "kind": "audio",
      "src": "/assets/audio/u03/listening-02.wav",
      "script": "ユイは、あさろくじはんにおきます。しちじはんにたべます。よるくじにねます。",
      "sha256": "06efab1bdf27e36a09e49523a61d5ed76a5c0a463d18b30c538b2d54f23bc31a",
      "status": "NOT_RUN",
      "reviewer": null,
      "reviewedAt": null
    },
    {
      "id": "audio:/assets/audio/u03/listening-03.wav",
      "kind": "audio",
      "src": "/assets/audio/u03/listening-03.wav",
      "script": "リクは、よるはべんきょうしません。よるはちじによみます。くじにねます。",
      "sha256": "ec42c44e13e0978edeaa36cfeeeb80c2a4552b74766611e09673d8c05bcb2b5a",
      "status": "NOT_RUN",
      "reviewer": null,
