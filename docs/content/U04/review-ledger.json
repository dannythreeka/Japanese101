      "kind": "audio",
      "src": "/assets/audio/u04/U04-teach-G11.wav",
      "script": "にわに、いぬがいます。つくえのうえに、ほんがあります。へやに、せんせいがいます。",
      "sha256": "9bf9054f97017f86be698f81c5ef9f626b6fdcbf8438b40e275e6251716ae40b",
      "status": "NOT_RUN",
      "reviewer": null,
