    },
    {
      "id": "audio:/assets/audio/u06/U06-teach-G18.wav",
      "kind": "audio",
      "src": "/assets/audio/u06/U06-teach-G18.wav",
      "script": "みずをください。パンをください。おにぎりをください。これは、ものをたのむいいかたです。",
      "sha256": "45039a564ed7202f08b97a6081da601c1ca863248e7cbf853723192aabf6c981",
      "status": "NOT_RUN",
      "reviewer": null,
