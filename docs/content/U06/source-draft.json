  "readings": [
    {
      "id": "U06-R01",
      "text": "あさです。わたしは パンを 食べます。ぎゅうにゅうを 飲みます。ジュースは 飲みません。",
      "skillId": "R-SHORT"
    },
    {
      "id": "U06-R02",
      "text": "わたしは りんごが 好きです。バナナが 嫌いです。きょうは りんごを 食べます。",
      "skillId": "R-SHORT"
    },
    {
      "id": "U06-R03",
      "text": "ひるです。わたしと ともだちは みせに います。わたしは おにぎりを 食べます。ともだちは うどんを 食べます。わたしは みずを 飲みます。ともだちも みずを 飲みます。わたしは うどんも 好きです。でも、きょうは おにぎりです。",
      "skillId": "R-MID"
    },
    {
      "id": "U06-R04",
      "text": "きょうの メニュー\nパン：あります\nおにぎり：ありません\nスープ：あります\nみず：あります\nぎゅうにゅう：ありません",
      "skillId": "R-INFO"
    }
  ],
